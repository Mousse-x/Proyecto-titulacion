# ═══════════════════════════════════════════════════════════════════
#  SisTransp — variables de PRODUCCIÓN (servidor casero + Cloudflare Tunnel)
#  En el servidor: cp .env.production.example .env  y rellena los valores.
#  backend/.env NO se sube a Git.
# ═══════════════════════════════════════════════════════════════════

# --- Django ---
DEBUG=False
# Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Tu dominio (o el *.trycloudflare.com si usas el túnel rápido), separados por coma.
ALLOWED_HOSTS=sistransp.tudominio.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://sistransp.tudominio.com
# URL pública: se usa en los enlaces de "restablecer contraseña".
FRONTEND_URL=https://sistransp.tudominio.com

# Si accedes desde la red local por http://IP, pon estas dos en False
# (las cookies "secure" solo viajan por HTTPS).
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- PostgreSQL ---
DB_NAME=transparencia_universitaria
DB_USER=sistransp
DB_PASSWORD=CAMBIAR
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Cifrado de correos ---
# Copia EXACTAMENTE el valor de tu backend/.env actual. Si cambia, los correos
# guardados en la base de datos ya no se podrán descifrar.
FIELD_ENCRYPTION_KEY=COPIAR_DEL_ENV_ACTUAL

# --- Correo (Brevo SMTP) ---
EMAIL_HOST_USER=CAMBIAR
EMAIL_HOST_PASSWORD=CAMBIAR
DEFAULT_FROM_EMAIL=SisTransp ESPOCH <sistema_transparencia@hotmail.com>

# --- OCR (Linux: apt install tesseract-ocr tesseract-ocr-spa) ---
TESSERACT_CMD=/usr/bin/tesseract

# --- IA (FreeLLMAPI debe correr también en el servidor) ---
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=

# --- Buscadores para la evaluación internacional (copia los de tu .env actual) ---
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
LINKUP_API_KEY=
SERP_API_KEY=
SERP_PROVIDER=serpapi
SEARCH_DIRECT_ENABLED=1
INTERNATIONAL_DEEP_SEARCH=1
